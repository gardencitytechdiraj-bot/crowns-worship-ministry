# Server-only Supabase configuration. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional comma-separated exact origins for an explicitly trusted separate frontend.
# Same-origin requests are allowed automatically; wildcard origins are not supported.
CORS_ORIGIN=
